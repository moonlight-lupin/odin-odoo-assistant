# --- Odoo config & credentials (secrets / instance-specific) ---
# Never commit the live config. The committed template is odoo_config.example.json.
odoo_config.json
**/odoo_config.json
# Per-user credentials (username + api_key) read by Odin
creds.txt
odin_credentials.txt
**/odin_credentials.txt
New Text Document.txt
# Per-user access scope (user-private; never shared)
access/
**/access/
# Docker bind-mount config dir (seeded from the example on first run)
odoo-mcp/config/

# --- Audit trail (operational data: who touched which records, when) ---
# Written by the MCP server's logging interface. Never commit it.
mcp-audit.jsonl
**/mcp-audit.jsonl
mcp-audit.jsonl.*
**/mcp-audit.jsonl.*

# --- Instance-specific deliverables generated by Odin playbooks (not part of the product) ---
odoo-context/
month-end-review/
bookkeeping/
reports/
audit/

# --- Local AI agent state & instance memory (user-private; never publish) ---
.claude/
**/.claude/
CLAUDE.md

# --- Build / packaging artifacts ---
*.tar
*.zip

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env

# --- OS / editor cruft ---
.DS_Store
Thumbs.db

# Claude Code plugin archive (built from odoo-assistant-plugin/)
*.plugin

# Plugin MCP connector — points at YOUR instance. Tracked as .mcp.json.example;
# build_plugin.py seeds this from it on first run.
odoo-assistant-plugin/.mcp.json
.pytest_cache/
