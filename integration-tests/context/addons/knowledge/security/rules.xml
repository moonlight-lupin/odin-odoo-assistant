<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read: open articles, or ones where the user is a member. -->
    <record id="rule_article_read" model="ir.rule">
        <field name="name">article: read</field>
        <field name="model_id" ref="model_knowledge_article"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('internal_permission', '!=', 'none'), ('article_member_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <!-- Write/create: open-for-edit articles, or ones the user is a writing member of. -->
    <record id="rule_article_write" model="ir.rule">
        <field name="name">article: write</field>
        <field name="model_id" ref="model_knowledge_article"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('internal_permission', '=', 'write'), ('article_member_ids', 'any', [('partner_id', '=', user.partner_id.id), ('permission', '=', 'write')])]</field>
        <field name="perm_read" eval="False"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
</odoo>
